# Looponics AI Assistant — Environment Variables Template
# Copy this file to .env.local for local development.
# DO NOT commit real secrets or keys to version control.

# Google Gemini API Key (Server-side only — never expose to client)
GEMINI_API_KEY=

# Primary Gemini Model Candidate
GEMINI_MODEL=gemini-3.5-flash-lite

# Allowed Origins for CORS/API validation (comma-separated)
ALLOWED_ORIGINS=https://looponics.tech,https://www.looponics.tech

# Supabase PostgreSQL + pgvector (Phase 2 RAG)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
